{
  "name": "ashley-jack",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "watch:css": "npm run build:css -- --watch",
    "copy:assets": "cpx 'assets/**/*' 'dist/assets'",
    "watch:assets": "npm run copy:assets -- --watch",
    "serve": "live-server dist",
    "build": "npm-run-all -s copy:assets build:css",
    "dev": "npm-run-all --parallel watch:* serve"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "cpx": "^1.5.0",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5"
  }
}
